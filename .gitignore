# Python & Virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints

# IDE & Editor files
.vscode/
.idea/
.agents/
*.swp
*.swo

# Project context & notes
context.md

# UV config and lock files
pyproject.toml
uv.lock
uv.toml
.uv/

# Generated parsing outputs & large artifacts
/output/
parsing/output/*
!parsing/output/full_docling_parsed.json
!parsing/output/classified_images.json
figures/
**/figures/
*.parquet

# Root json ignore (except in parsing/output)
*.json
!parsing/output/full_docling_parsed.json
!parsing/output/classified_images.json

# Temporary & cache
.cache/
tmp/
*.log
.DS_Store

# Helper and scratch scripts (only allow run_classification.py and retry_failed.py)
parsing/scripts/*
!parsing/scripts/run_classification.py
!parsing/scripts/retry_failed.py

# Chunking outputs & scratch scripts
chunking/output/*
chunking/build_notebook.py
chunking/generate_enhanced_notebook.py
chunking/inspect_errors.py
